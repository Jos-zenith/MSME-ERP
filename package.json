{
  "name": "vina",
  "version": "0.1.0",
  "private": true,
  "description": "Vina: offline-first billing, stock and GST for Indian MSMEs, with UPI that confirms itself (Smart Collect) and a Credit Passport. Low-code: forms, workflows, dashboards.",
  "type": "module",
  "scripts": {
    "start": "node scripts/build-sw.mjs && node server/server.js",
    "build:sw": "node scripts/build-sw.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm test && npm run test:e2e",
    "i18n:missing": "node scripts/extract-i18n.mjs --everyday --missing",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "puppeteer-core": "^23.0.0"
  }
}
